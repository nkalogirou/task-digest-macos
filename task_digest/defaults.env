# -----------------------------------------------------------------------------
# Task Digest configuration
# Copy this file to .env, then fill in the required values.
# Secrets should be stored in macOS Keychain, not in this file.
# -----------------------------------------------------------------------------

# Required: Asana workspace GID.
ASANA_WORKSPACE_GID=

# Keychain location used by `python -m task_digest.keychain store-asana`.
ASANA_TOKEN_KEYCHAIN_SERVICE=app.taskdigest.asana
ASANA_TOKEN_KEYCHAIN_ACCOUNT=asana

# Optional: comma-separated Asana project GIDs.
# Leave blank to include every incomplete task assigned to you in the workspace.
ASANA_PROJECT_GIDS=

# My Tasks section visibility rules (case-insensitive, comma-separated).
EXCLUDE_SECTIONS=Drafts
OPTIONAL_SECTIONS=Investigations

# Workflow classification by Asana status value (case-insensitive).
ACTION_STATUSES=Pending,In Development,Changes Requested,To Do,Ready
WAITING_STATUSES=In Review,In Deployment,Blocked,Waiting,Waiting for Review,Waiting for Deployment
STALE_WAITING_DAYS=5
SMART_PLAN_MAX_ITEMS=5
SMART_PLAN_STALE_WAITING_LIMIT=1
INCLUDE_ASANA_DEPENDENCIES=true
RECENT_COMMENT_LIMIT=3

# Safer public default: Asana write actions are disabled until explicitly enabled.
ENABLE_ASANA_WRITE_ACTIONS=false

# GitHub data. Uses the authenticated GitHub CLI; no GitHub token is stored here.
INCLUDE_GITHUB_REVIEWS=false
INCLUDE_GITHUB_AUTHORED_PRS=false
INCLUDE_GITHUB_ASSIGNED_ISSUES=false
INCLUDE_GITHUB_MENTIONS=false
INCLUDE_LINKED_PR_STATUS=false

# Required when any GitHub source above is enabled.
# Example: GITHUB_REPOSITORIES=acme-inc/web-app,acme-inc/api
GITHUB_REPOSITORIES=
GITHUB_REVIEW_LIMIT=50
GITHUB_PR_LIMIT=50
GITHUB_ISSUE_LIMIT=50
GITHUB_MENTION_LIMIT=50
GITHUB_CLI_PATH=

# Local schedule. Your Mac's current timezone is used automatically.
MORNING_TIME=10:00
EVENING_TIME=17:30
SCHEDULE_WINDOW_MINUTES=20

# Local state and generated files.
STATE_FILE=state/digest_state.json
PREFERENCES_FILE=state/task_preferences.json
WORKSPACE_FILE=state/workspace.json
JOURNAL_FILE=state/activity_log.json
RULES_FILE=state/task_rules.json
DASHBOARD_TOKEN_FILE=state/dashboard_token
REPORT_FILE=output/task-digest.html
HISTORY_DIR=history

# Local-only dashboard. Keep 127.0.0.1 unless you fully understand the risk.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_REFRESH_MINUTES=5
MENU_REFRESH_MINUTES=5

# Notifications. Action buttons use Alerter when installed.
ACTIONABLE_NOTIFICATIONS=true
NOTIFICATION_SNOOZE_MINUTES=60
OPEN_REPORT=false
OPEN_DASHBOARD_ON_SCHEDULE=false

# Local backup and restore.
BACKUP_DIR=backups
BACKUP_RETENTION_COUNT=30
